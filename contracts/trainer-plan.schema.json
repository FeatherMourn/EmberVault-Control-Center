{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.local/contracts/trainer-plan.schema.json",
  "title": "EmberVault Trainer Plan",
  "type": "object",
  "required": ["schema_version", "plan", "application_state", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "plan": {
      "type": "object",
      "required": ["id", "profile_id", "target", "notes", "backup_id", "created_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "backup_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "application_state": {"const": "trainer-plan-only"},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
