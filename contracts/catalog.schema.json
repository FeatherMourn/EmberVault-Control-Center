{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.local/contracts/catalog.schema.json",
  "title": "EmberVault Public Catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "contract_versions", "packages", "modules", "tuning_adapters", "knowledge", "research", "content_projects"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "contract_versions": {
      "type": "object",
      "required": ["module_manifest", "package_manifest", "research_record", "content_project", "tuning_adapter", "integration_context"],
      "properties": {
        "module_manifest": {"type": "integer", "minimum": 1},
        "package_manifest": {"type": "integer", "minimum": 1},
        "research_record": {"type": "integer", "minimum": 1},
        "content_project": {"type": "integer", "minimum": 1},
        "tuning_adapter": {"type": "integer", "minimum": 1},
        "integration_context": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "packages": {"type": "array", "items": {"type": "object"}},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "publisher", "capabilities", "feature_state", "process_mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "feature_state": {"type": "string"},
          "process_mode": {"enum": ["embedded", "separate"]},
          "minimum_core_version": {"type": "string"},
          "executable": {"type": ["string", "null"]},
          "entrypoint": {"type": ["string", "null"]},
          "path": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "tuning_adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "loader", "game_build", "supported_setting_keys", "feature_state", "process_mode", "evidence_state"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "loader": {"type": "string", "minLength": 1},
          "game_build": {"type": "string", "minLength": 1},
          "supported_setting_keys": {"type": "array", "items": {"type": "string"}},
          "feature_state": {"type": "string", "minLength": 1},
          "process_mode": {"enum": ["embedded", "separate"]},
          "evidence_state": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "knowledge": {"type": "array", "items": {"type": "object", "required": ["id", "title", "category", "summary", "content", "published_at", "tags", "related_ids", "evidence_refs", "version"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "category": {"type": "string"}, "summary": {"type": "string"}, "content": {"type": "string"}, "published_at": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}}, "related_ids": {"type": "array", "items": {"type": "string"}}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "version": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "hypothesis", "status", "evidence_count", "created_at", "published_at", "game_build", "game_version", "reproduction_step_count", "failure_count", "promotion_status", "linked_package_count", "linked_module_count", "linked_knowledge_count"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "status": {"const": "completed"},
          "evidence_count": {"type": "integer", "minimum": 1},
          "created_at": {"type": "string"},
          "published_at": {"type": "string", "minLength": 1},
          "game_build": {"type": "string"}, "game_version": {"type": "string"},
          "reproduction_step_count": {"type": "integer", "minimum": 0},
          "failure_count": {"type": "integer", "minimum": 0},
          "promotion_status": {"enum": ["not-requested", "requested", "approved", "rejected"]},
          "linked_package_count": {"type": "integer", "minimum": 0},
          "linked_module_count": {"type": "integer", "minimum": 0},
          "linked_knowledge_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "content_projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "published_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "ready"},
          "published_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
