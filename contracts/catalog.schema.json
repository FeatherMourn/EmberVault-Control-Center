{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.local/contracts/catalog.schema.json",
  "title": "EmberVault Public Catalog",
  "type": "object",
  "required": ["schema_version", "contract_versions", "packages", "modules", "knowledge", "research", "content_projects"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_versions": {
      "type": "object",
      "required": ["module_manifest", "package_manifest", "research_record", "content_project", "tuning_adapter"],
      "properties": {
        "module_manifest": {"type": "integer", "minimum": 1},
        "package_manifest": {"type": "integer", "minimum": 1},
        "research_record": {"type": "integer", "minimum": 1},
        "content_project": {"type": "integer", "minimum": 1},
        "tuning_adapter": {"type": "integer", "minimum": 1}
      }
    },
    "packages": {"type": "array", "items": {"type": "object"}},
    "modules": {"type": "array", "items": {"type": "object"}},
    "knowledge": {"type": "array", "items": {"type": "object"}},
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "hypothesis", "status", "evidence_count", "created_at", "published_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "status": {"const": "completed"},
          "evidence_count": {"type": "integer", "minimum": 1},
          "created_at": {"type": "string"},
          "published_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "content_projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "published_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "ready"},
          "published_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
