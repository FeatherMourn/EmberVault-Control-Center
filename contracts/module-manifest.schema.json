{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.dev/contracts/module-manifest.schema.json",
  "x-canonical-source": "EmberVault-Contracts/schemas/module-manifest.schema.json",
  "type": "object",
  "required": ["id", "name", "version", "publisher", "capabilities"],
  "properties": {
    "id": {"type": "string", "pattern": "^embervault\\.[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "executable": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.).+"},
    "minimum_core_version": {"type": "string"},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "feature_state": {"enum": ["stable", "verified", "experimental", "research-only", "blocked"]},
    "entrypoint": {"type": ["string", "null"]},
    "process_mode": {"enum": ["embedded", "separate"]}
    ,"contract_version": {"const": 1},
    "safety": {
      "type": "object",
      "required": ["read_only", "requires_backup", "allowed_profiles"],
      "properties": {
        "read_only": {"type": "boolean"},
        "requires_backup": {"type": "boolean"},
        "allowed_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["rollback", "verification"],
      "properties": {
        "rollback": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "operation_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
