{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.local/contracts/content-project.schema.json",
  "title": "EmberVault Content Design Project",
  "type": "object",
  "required": ["schema_version", "project", "application_state", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "required": ["id", "name", "profile_id", "status", "description", "design_type", "design_notes", "asset_references", "published", "published_at", "materials", "dimensions", "recipe_plan", "registration_plan", "compatibility_notes", "linked_research_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "ready", "blocked"]},
        "description": {"type": "string"},
        "design_type": {"enum": ["furniture", "building", "recipe", "other"]},
        "design_notes": {"type": "string"},
        "asset_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "published": {"type": "boolean"},
        "published_at": {"type": "string"},
        "materials": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dimensions": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": 0}},
        "recipe_plan": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "registration_plan": {"type": "string"},
        "compatibility_notes": {"type": "string"},
        "linked_research_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "application_state": {"const": "design-only"},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
