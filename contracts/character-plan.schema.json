{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.local/contracts/character-plan.schema.json",
  "title": "EmberVault Character Plan",
  "type": "object",
  "required": ["schema_version", "character", "application_state", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "character": {
      "type": "object",
      "required": ["id", "name", "profile_id", "notes", "planned_level", "build_goals", "progression_plan", "equipment_notes", "skill_notes", "verified_backup_id", "build_template", "version", "history"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "notes": {"type": "string"},
        "planned_level": {"type": "integer", "minimum": 1, "maximum": 50},
        "build_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "progression_plan": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "equipment_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "skill_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verified_backup_id": {"type": "string"},
        "build_template": {"enum": ["general", "tank", "damage", "support", "gatherer"]},
        "version": {"type": "integer", "minimum": 1},
        "history": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "application_state": {"const": "plan-only"},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
