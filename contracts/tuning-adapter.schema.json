{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embervault.local/contracts/tuning-adapter.schema.json",
  "title": "EmberVault Gameplay Tuning Adapter",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "process_mode", "loader", "loader_api_version", "game_build", "supported_setting_keys", "backup_requirements", "mutation_scope", "verification_steps", "feature_state"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "process_mode": {"enum": ["embedded", "separate"]},
    "loader": {"type": "string", "minLength": 1},
    "loader_api_version": {"type": "string", "minLength": 1},
    "game_build": {"type": "string", "minLength": 1},
    "supported_setting_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "backup_requirements": {"type": "string", "minLength": 1},
    "mutation_scope": {"type": "string", "minLength": 1},
    "verification_steps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "feature_state": {"enum": ["experimental", "verified"]}
  },
  "additionalProperties": false
}
